{
	field(DESC, "CLIDAT field for FMT sim roweditor")
	field(DTYP, "asynInt32")
	field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))FMT_REDIT_CLIDAT")
	field(PINI, "YES")
	field(VAL,  "0")
