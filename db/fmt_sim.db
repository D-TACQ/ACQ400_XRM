record(longout, "${UUT}:FMT_SIM:REDIT:CLIDAT_STEP")
{
	field(DESC, "CLIDAT step for FMT sim roweditor")
	field(DTYP, "asynInt32")
	field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))FMT_REDIT_CLIDAT_STEP")
	field(PINI, "YES")
	field(VAL,  "0")
	info(Q:group, {
