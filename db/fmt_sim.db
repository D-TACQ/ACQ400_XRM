# fmt_sim.db: REDIT : Row EDIT

record(longout, "${UUT}:FMT_SIM:REDIT:ROW")
{
	field(DESC, "First target row for FMT sim roweditor")
	field(DTYP, "asynInt32")
	field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))FMT_REDIT_ROW")
	field(PINI, "YES")
	field(VAL,  "0")
	info(Q:group, {
		"${UUT}:FMT_SIM:REDIT": {
			"ROW": {+channel:"VAL"}
		}
	})
}

record(longout, "${UUT}:FMT_SIM:REDIT:ROWCOUNT")
{
	field(DESC, "Number of Target rows for FMT sim roweditor")
	field(DTYP, "asynInt32")
	field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))FMT_REDIT_ROWCOUNT")
	field(PINI, "YES")
	field(VAL,  "1")
	info(Q:group, {
		"${UUT}:FMT_SIM:REDIT": {
			"ROWCOUNT": {+channel:"VAL"}
		}
	})
}

