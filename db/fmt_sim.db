record(longout, "${UUT}:FMT_SIM:REDIT:COMMIT")
{
	field(DESC, "Write selected rowedits into FMT")
	field(DTYP, "asynInt32")
	field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))FMT_REDIT_COMMIT")
	info(Q:group, {
		"${UUT}:FMT_SIM:REDIT": {
			"COMMIT": {+type:"proc", +channel:"VAL",
				   +trigger:"*"
			}
		}
	})
}

record(longout, "${UUT}:FMT_SIM:FMT_DELAY")
{
	field(DESC, "Delay FMT TX by N microseconds")
	field(DTYP, "asynInt32")
	field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))FMT_DELAY")
	field(EGU,  "ms")
	field(VAL,  "0")
	field(PINI, "YES")
	field(LOPR, "0")
	field(HOPR, "100")
}

record(bo, "${UUT}:FMT:RUNSTOP")
{
	field(DESC, "Set to run/stop FMT TX")
	field(VAL, "1")
	field(PINI, "YES")
}


