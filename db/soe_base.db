record(longout, "${UUT}:SOE_LUT:REDIT:COMMIT")
{
	field(DESC, "Run roweditor with the set option on the SoE LUT")
	field(DTYP, "asynInt32")
	field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))SOE_LUT_REDIT_COMMIT")
	info(Q:group, {
		"${UUT}:SOE_LUT:REDIT": {
			"COMMIT": {+type:"proc", +channel:"VAL",
				   +trigger:"*"
			}
		}
	})
}

