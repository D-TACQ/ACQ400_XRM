# soe_base : Sample On Event

record(bo, "${UUT}:SOE:RUNSTOP")
{
	field(DESC, "Start/stop Sample on Event")
	field(PINI, "YES")
	field(DTYP, "asynInt32")
	field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))RUNSTOP")
	field(SCAN, "Passive")
	field(ZNAM, "STOP")
	field(ONAM, "RUN")
	field(VAL,  "0")
}

record(mbbo, "${UUT}:SOE:STRATEGY")
{
	field(DESC, "Select which SoE strategy to use")
	field(PINI, "YES")
	field(VAL,  "0")
	field(DTYP, "asynInt32")
	#field(DTYP, "asynEnum")
	field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))SOE_STRATEGY")
	field(NOBT, "3")
	field(ZRST, "LutFmtStrategy1")
	field(ONST, "LutFmtStrategy2")
	field(TWST, "Copy64(stride=1)")
	field(THST, "Copy64(stride=2)")
	field(FRST, "Copy64(stride=5)")
	field(FVST, "Copy64(stride=10)")
	field(SXST, "Copy64(stride=20)")
	field(ZRVL, "0")
	field(ONVL, "1")
	field(TWVL, "2")
	field(THVL, "3")
	field(FRVL, "4")
	field(FVVL, "5")
	field(SXVL, "6")
	field(PINI, "YES")
	field(VAL,  "1")
}
record(longin, "${UUT}:SOE:UPDATES")
{
	field(DESC, "Count of SoE updates")
	field(PINI, "NO")
	field(DTYP, "asynInt32")
	field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))UPDATES")
	field(SCAN, "I/O Intr")
	field(TSE,  "-2")
}

record(longin, "${UUT}:SOE:FMT_RX_TIMEOUTS")
{
	field(DESC, "Count of FMT RX timeouts")
	field(PINI, "NO")
	field(DTYP, "asynInt32")
	field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))SOE_FMT_RX_TIMEOUTS")
	field(SCAN, "I/O Intr")
	field(TSE,  "-2")

	field(DESC, "Data buffer is waiting but FMT no show")
}

record(longin, "${UUT}:SOE:FMT_RX_TIMEOUT_REASON")
{
	field(DESC, "reason for last error")
	field(PINI, "NO")
	field(DTYP, "asynInt32")
	field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))SOE_FMT_RX_TIMEOUT_REASON")
	field(SCAN, "I/O Intr")
	field(TSE,  "-2")
}

record(longin, "${UUT}:SOE:FMT_RX_SUCCESS")
{
	field(DESC, "Successful matchups")
	field(PINI, "NO")
	field(DTYP, "asynInt32")
	field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))SOE_FMT_RX_SUCCESS")
	field(SCAN, "I/O Intr")
	field(TSE,  "-2")
}

record(int64in, "${UUT}:SOE:FMT:DELTA_TS")
{
	field(DESC, "Difference first Buf TS and FMT TS")
	field(PINI, "NO")
	field(DTYP, "asynInt64")
	field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))SOE_FMT_DELTA_TS")
	field(SCAN, "I/O Intr")
	field(TSE,  "-2")
	field(EGU,  "usec")
}

record(longin, "${UUT}:SOE:FMT:EV_MATCHES")
{
	field(DESC, "Number of Events matched this CYCLE")
	field(PINI, "NO")
	field(DTYP, "asynInt32")
	field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))SOE_FMT_EV_MATCHES")
	field(SCAN, "I/O Intr")
	field(TSE,  "-2")
}

record(longin, "${UUT}:SOE:FMT:EV_NIB")
{
	field(DESC, "Number of Events NOT IN BUFFER")
	field(PINI, "NO")
	field(DTYP, "asynInt32")
	field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))SOE_FMT_EV_NOT_IN_BUFFER")
	field(SCAN, "I/O Intr")
	field(TSE,  "-2")
}


record(longin, "${UUT}:SOE:FMT:BUF_POS")
{
	field(DESC, "FMT buffer in use -1:PRE, 0:CUR, 1:NEXT")
	field(PINI, "NO")
	field(DTYP, "asynInt32")
	field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))SOE_FMT_BUF_POS")
	field(SCAN, "I/O Intr")
	field(TSE,  "-2")
}

record(longin, "${UUT}:SOE:FMT:NEXT_RETRY")
{
	field(DESC, "if NEXT, numretries (delay CYCLE/5)")
	field(PINI, "NO")
	field(DTYP, "asynInt32")
	field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))SOE_FMT_NEXT_RETRY")
	field(SCAN, "I/O Intr")
	field(TSE,  "-2")
	#            1234567890123456789012345678901234567890
}

record(int64in, "${UUT}:SOE:TS_USEC")
{
	field(DESC, "Timestamp in microseconds")
	field(PINI, "NO")
	field(DTYP, "asynInt64")
	field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))TS_USEC")
	field(SCAN, "I/O Intr")
	field(TSE,  "-2")
	field(EGU,  "usec")
}

record(longin, "${UUT}:SOE:KBUF:INDEX")
{
	field(DESC, "current buffer number")
	field(PINI, "NO")
	field(DTYP, "asynInt32")
	field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))SOE_KBUF_INDEX")
	field(SCAN, "I/O Intr")
	field(TSE,  "-2")
	info(Q:group, {
		"${UUT}:SOE:KBUF": {
			"INDEX": {+channel:"VAL"}
		}
	})
}
record(int64in, "${UUT}:SOE:KBUF:WRT0")
{
	field(DESC, "start time in buffer")
	field(PINI, "NO")
	field(DTYP, "asynInt64")
	field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))SOE_KBUF_WRT0")
	field(SCAN, "I/O Intr")
	field(TSE,  "-2")
	info(Q:group, {
		"${UUT}:SOE:KBUF": {
			"WRT0": {+channel:"VAL"}
		}
	})
}
record(int64in, "${UUT}:SOE:KBUF:WRT1")
{
	field(DESC, "end time in buffer")
	field(PINI, "NO")
	field(DTYP, "asynInt64")
	field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))SOE_KBUF_WRT1")
	field(SCAN, "I/O Intr")
	field(TSE,  "-2")
	info(Q:group, {
		"${UUT}:SOE:KBUF": {
			"WRT1": {+channel:"VAL"}
		}
	})
}


record(waveform, "${UUT}:SOE_LUT:TAB:Labels_") {
	field(DESC, "Labels for SoE LUT")
	field(FTVL, "STRING")
	field(NELM, "5")
	field(INP , {const:["Row", "Event", "Pad", "PV_ID", "OFFSET_US"]})
	info(Q:group, {
		"${UUT}:SOE_LUT:TAB:Tbl":{
			+id:"epics:nt/NTTable:1.0",
			"labels":{+type:"plain", +channel:"VAL"}
		}
	})
	field(TPRO, "1")
}

record(waveform, "${UUT}:SOE_LUT:TAB:ROWNUM")
{
	field(DESC, "Row numbers for SoE LUT")
	field(DTYP, "asynInt8ArrayIn")
	field(INP,  "@asyn($(PORT),0,$(TIMEOUT))SOE_LUT_COL_ROWNUM")
	field(FTVL, "UCHAR")
	field(NELM, "64")
	field(SCAN, "I/O Intr")
	info(Q:group, {
		"${UUT}:SOE_LUT:TAB:Tbl": {
			"value.ROWNUM": {+type:"plain", 
					 +channel:"VAL", +putorder:0 }
		}
	})
}

record(waveform, "${UUT}:SOE_LUT:TAB:EVENT")
{
	field(DESC, "Event number in SoE LUT")
	field(DTYP, "asynInt16ArrayIn")
	field(INP,  "@asyn($(PORT),0,$(TIMEOUT))SOE_LUT_COL_EVENT")
	field(FTVL, "USHORT")
	field(NELM, "64")
	field(SCAN, "I/O Intr")
	info(Q:group, {
		"${UUT}:SOE_LUT:TAB:Tbl": {
			"value.EVENT": {+type:"plain", 
					+channel:"VAL", +putorder:1 }
		}
	})
}

record(waveform, "${UUT}:SOE_LUT:TAB:PAD")
{
	field(DESC, "Pad value in SoE LUT")
	field(DTYP, "asynInt16ArrayIn")
	field(INP,  "@asyn($(PORT),0,$(TIMEOUT))SOE_LUT_COL_PAD")
	field(FTVL, "USHORT")
	field(NELM, "64")
	field(SCAN, "I/O Intr")
	info(Q:group, {
		"${UUT}:SOE_LUT:TAB:Tbl": {
			"value.PAD": {+type:"plain", 
				      +channel:"VAL", +putorder:2 }
		}
	})
}

record(waveform, "${UUT}:SOE_LUT:TAB:PV_ID")
{
	field(DESC, "PV ID in SoE LUT")
	field(DTYP, "asynInt32ArrayIn")
	field(INP,  "@asyn($(PORT),0,$(TIMEOUT))SOE_LUT_COL_PV_ID")
	field(FTVL, "ULONG")
	field(NELM, "64")
	field(SCAN, "I/O Intr")
	info(Q:group, {
		"${UUT}:SOE_LUT:TAB:Tbl": {
			"value.CLIDAT": {+type:"plain", 
					 +channel:"VAL", +putorder:3 }
		}
	})
}

record(waveform, "${UUT}:SOE_LUT:TAB:TS")
{
	field(DESC, "Timestamp in SoE LUT")
	field(DTYP, "asynInt64ArrayIn")
	field(INP,  "@asyn($(PORT),0,$(TIMEOUT))SOE_LUT_COL_OFFSET_US")
	field(FTVL, "INT64")
	field(NELM, "64")
	field(SCAN, "I/O Intr")
	info(Q:group, {
		"${UUT}:SOE_LUT:TAB:Tbl": {
			"value.TS": {+type:"plain", 
				     +channel:"VAL", 
				     +putorder:4, +trigger:"*" }
		}
	})
}

record(longout, "${UUT}:SOE_LUT:TAB:Save")
{
    field(DESC, "TODO")
    field(MDEL, "-1") # ensure we always trigger group monitor
    field(TPRO, "1")
    info(Q:group, {
	"${UUT}:SOE_LUT:TAB:Tbl":{
	    "_save":{+type:"proc",
		     +channel:"VAL",
		     +putorder:5,
		     +trigger:"*"}
	}
    })
}


record(longout, "${UUT}:SOE_LUT:REDIT:ROW")
{
	field(DESC, "Start row in SoE LUT roweditor")
	field(DTYP, "asynInt32")
	field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))SOE_LUT_REDIT_ROW")
	field(PINI, "YES")
	field(VAL,  "0")
	info(Q:group, {
		"${UUT}:SOE_LUT:REDIT": {
			"ROW": {+channel:"VAL"}
		}
	})
}

