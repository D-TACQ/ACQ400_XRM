
record(waveform, "${UUT}:PRMT:LUT:TAB:Labels_") {
	field(FTVL, "STRING")
	field(NELM, "8")
	field(INP , {const:["Row", "EVENT", 
	 		"AI/S1", "AI/S2", "AI/S3", "AI/S4",
	 		"DI32/S5", "DI32/S6"]})
				
	info(Q:group, {
		"${UUT}:PRMT:LUT:TAB":{
			+id:"epics:nt/NTTable:1.0",
			"labels":{+type:"plain", +channel:"VAL"}
		}
	})
	field(TPRO, "1")
}

record(waveform, "${UUT}:SOE_HLD:TAB:ROWNUM")
{
	field(DTYP, "asynInt8ArrayIn")
	field(INP,  "@asyn($(SPORT),0,$(TIMEOUT))PRMT_LUT_COL_ROW_NUM")
	field(FTVL, "UCHAR")
	field(NELM, "${PL_ROWS}")
	field(SCAN, "I/O Intr")
	field(DESC, "Row Number Column")
	info(Q:group, {
		"${UUT}:PRMT:LUT:TAB": {
			"value.ROWNUM": {+type:"plain", 
					 +channel:"VAL", +putorder:0 }
		}
	})
}


