record(waveform, "${UUT}:PRMT:LUT:TAB:EVENT" ){
	field(DTYP, "asynInt32ArrayIn")
	field(INP,  "@asyn($(SPORT),0,$(TIMEOUT))PRMT_LUT_EV_COL")
	field(FTVL, "LONG")
	field(SCAN, "I/O Intr")
	field(NELM, "${PL_ROWS}") 
	field(DESC, "Event Column")
	
	info(Q:group, {
		"${UUT}:PRMT:LUT:TAB": {
			"value.EVENT": {+type:"plain", 
					 +channel:"VAL", +putorder:7,
					 +trigger:"*"
			}
		}
	})	
}


record(longout, "${UUT}:PRMT:LUT:TAB:Save") {
    field(MDEL, "-1") # ensure we always trigger group monitor
    field(TPRO, "1")
    info(Q:group, {
	"${UUT}:PRMT:LUT:TAB":{
	    "_save":{+type:"proc",
		     +channel:"VAL",
		     +putorder:8,
		     +trigger:"*"}
	}
    })
}

