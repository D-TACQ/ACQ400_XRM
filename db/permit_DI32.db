
record(mbboDirect, "$(UUT):$(SITE):PRMT:DI32:CH_ACTIVE")
{
	field(DESC, "Permit channel active")
	field(DTYP, "asynUInt32Digital")
	field(OUT,  "@asynMask($(PORT),0,4294967295,$(TIMEOUT))PERMIT_DI_CH_ACTIVE")
}

record(mbboDirect, "$(UUT):$(SITE):PRMT:DI32:CH_VALUE")
{
	field(DESC, "Permit channel value")
	field(DTYP, "asynUInt32Digital")
	field(OUT,  "@asynMask($(PORT),0,4294967295,$(TIMEOUT))PERMIT_DI_CH_VALUE")
}
