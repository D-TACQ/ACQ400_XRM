#!/bin/sh
# load.prmt: load permit monitors.


echo "# load.prmt $1"

eval $(get.site 0 aggregator)

first_site=true

for site in $(echo $sites | tr , \  ); do
        SPORT=PRMT$site
        IS_ADC=$(get.site $site is_adc | awk '{ print $1 }')
        if [ "x$IS_ADC" = "x1" ]; then
                NCHAN=$(get.site $site NCHAN)
        else
                NCHAN=2       
        fi
        
        echo acq400_Permit_Configure\($SPORT, $site, $IS_ADC, $NCHAN\)
        ARP="P=${IOC_HOST}:,R=${SPORT},PORT=${SPORT},ADDR=0,IMAX=100,OMAX=100,TB3=0,TIB0=0"
        echo dbLoadRecords\(\"db/asynRecord.db\",\"${ARP}\"\)
	PRAMS="UUT=${IOC_HOST},PORT=$SPORT,SITE=$site,TIMEOUT=0"
        if $first_site; then
                echo dbLoadRecords\(\"db/acq400_asyn_base.db\",\"${PRAMS},ADDR=0,FUN=PRMT\"\)
		echo dbLoadRecords\(\"db/acq400_PRMT_base.db\",\"${PRAMS}\"\)
		
		first_site=false
        fi
        if [ "x$IS_ADC" = "x1" ]; then
                PDB=db/permit_AI_${NCHAN}CH.db
                echo dbLoadRecords\(\"$PDB\",\"${PRAMS}\"\)
	else
		echo dbLoadRecords\(\"db/permit_DI32.db\",\"${PRAMS}\"\)
        fi
done

XRM_PRMT_LUT_ROWS=${XRM_PRMT_LUT_ROWS:-16}
DEF_PRMT_LUT_DB=db/permit_lut_16R.db
PRMT_LUT_DB=db/permit_lut_${XRM_PRMT_LUT_ROWS}R.db

if [ ! -e $PRMT_LUT_DB ]; then
        echo "# $PRMT_LUT_DB does not exist, fallback to $DEF_PRMT_LUT_DB
        PRMT_LUT_DB=$DEF_PRMT_LUT_DB
fi
PRMT_LUT_MAX_AI=128
PRMT_LUT_MAX_DI=((2*2))
PRAMS="UUT=${IOC_HOST},PORT=PRMT_LUT,TIMEOUT=0"
echo dbLoadRecords\(\"db/$PRMT_LUT_DB\",\"${PRAMS}\"\)
