# @DIAMOND pattern
#http://www.aps.anl.gov/epics/tech-talk/2010/msg00131.php
# FUN   : setpoint
# FUN:r : readback
# FUN:s : sync
# FUN:w : write

# @DIAMOND
record(mbbo, "${UUT}:${SITE}:ANATRG:${CH}:M")	{
	field(DTYP, "Soft Channel")
	field(DESC, "permit mode [IN]ACTIVE")

	field(NOBT, "1")
	field(ZRST, "INACTIVE")
	field(ONST, "ACTIVE")
	field(FLNK, "${UUT}:${SITE}:ANATRG:${CH}:M:w PP")
}


record(mbbi, "${UUT}:${SITE}:ANATRG:${CH}:M:r")	{
	field(DTYP, "asynInt32")
	field(INP,  "@asyn(${PORT},${ADDR},${TIMEOUT})PERMIT_ATD_MODE")
	field(SCAN, "I/O Intr")
	field(PINI, "YES")
	field(FLNK, "${UUT}:${SITE}:ANATRG:${CH}:M:s")

	field(NOBT, "1")
	field(ZRST, "INACTIVE")
	field(ONST, "ACTIVE")
}

record(mbbo, "${UUT}:${SITE}:ANATRG:${CH}:M:s")	{
	field(DTYP, "Soft Channel")
	field(DOL,  "${UUT}:${SITE}:ANATRG:${CH}:M:r")
	field(OMSL, "closed_loop")
	field(OUT,  "${UUT}:${SITE}:ANATRG:${CH}:M PP")

	field(NOBT, "1")
	field(ZRST, "INACTIVE")
	field(ONST, "ACTIVE")       	
}

record(mbbo, "${UUT}:${SITE}:ANATRG:${CH}:M:w")	{
	field(DTYP, "asynInt32")
	field(OUT,  "@asyn(${PORT},${ADDR},${TIMEOUT})PERMIT_ATD_MODE")
	field(SDIS, "${UUT}:${SITE}:ANATRG:${CH}:M:s.PACT")
	field(DISV, "1")

	field(NOBT, "1")
	field(ZRST, "INACTIVE")
	field(ONST, "ACTIVE")
}

