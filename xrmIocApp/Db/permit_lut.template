record(longout, "${UUT}:PRMT:LUT:${ROW0}:EVENT"){
	field(DTYP, "asynInt32")
	field(OUT,  "@asyn($(SPORT),${ADDR},$(TIMEOUT))PRMT_LUT_EVENT")
	info(Q:group, {
		"${UUT}:PRMT:LUT:${ROW0}": {
			"EVENT": { +channel: "VAL", +putorder:0	}
		}
	})
	field(DESC, "Event to trigger this ROW")
}

record(aao, "${UUT}:PRMT:LUT:${ROW0}:TH:AI"){
	field(DTYP, "asynInt16ArrayOut")
	field(OUT, "@asyn($(SPORT),${ADDR},$(TIMEOUT))PRMT_LUT_TH_AI")
	info(Q:group, {
		"${UUT}:PRMT:LUT:${ROW0}": {
			"TH_AI": { +channel: "VAL", +putorder:1}
		}
	})
	field(FTVL, "SHORT")
	field(NELM, "${MAX_AI2}")
	field(DESC, "array AI thresholds, LO,HI")
}
	 
record(aao, "${UUT}:PRMT:LUT:${ROW0}:TH:DI"){
	field(DTYP, "asynInt32ArrayOut")
	field(OUT, "@asyn($(SPORT),${ADDR},$(TIMEOUT))PRMT_LUT_TH_DI")
	info(Q:group, {
		"${UUT}:PRMT:LUT:${ROW0}": {
			"TH_DI": { +channel: "VAL", +putorder:2}
		}
	})
	field(FTVL, "ULONG")
	field(NELM, "${MAX_DI}")
	field(DESC, "array DI, VALUE, ACTIVE pairs")
}
	 
record(longout, "${UUT}:PRMT:LUT:${ROW0}:COMMIT"){
	field(DTYP, "asynInt32")
	field(OUT,  "@asyn($(SPORT),${ADDR},$(TIMEOUT))PRMT_LUT_EVENT")
	info(Q:group, {
		"${UUT}:PRMT:LUT:${ROW0}": {
			"COMMIT": { +channel: "VAL", +putorder:3, +trigger:"*"}
		}
	})
	field(DESC, "Event to trigger this ROW")	
}
# or maybe this way? https://epics-base.github.io/pvxs/qgroup.html#database-listing

record(longout, "${UUT}:PRMT:LUT:${ROW0}:COMMIT2") {
    field(MDEL, "-1") # ensure we always trigger group monitor
    field(TPRO, "1")
    info(Q:group, {
	"${UUT}:PRMT:LUT:${ROW0}":{
	    "_save":{+type:"proc",
		     +channel:"VAL",
		     +putorder:3,
		     +trigger:"*"}
	}
    })
}

record(longout, "${UUT}:PRMT:LUT:SOFT_EVENT"){
	field(DTYP, "asynInt32")
	field(OUT,  "@asyn($(SPORT),${ADDR},$(TIMEOUT))PRMT_LUT_SOFT_EVENT")
	field(DESC, "trigger this event")
}

